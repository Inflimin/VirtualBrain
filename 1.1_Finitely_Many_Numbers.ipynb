    "# 1.1 Finitely Many Numbers\n",
    "\n",
    "Is $(\\sqrt{5})^2 = 5$? Run the cell to find out."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import math as m\n",
    "\n",
    "x = 5.0\n",
    "y = m.sqrt(5)**2\n",
    "\n",
    "print(\"x == y ?\", x == y)\n",
    "print(\"x = \", x)\n",
    "print(\"y = \", y)\n",
    "\n",
    "eps = 1e-10\n",
    "print(\"(x - y) is very small?\", abs(x-y) < eps)"
   ]
  }
